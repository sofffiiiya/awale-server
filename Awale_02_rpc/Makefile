# Awale client/server with Sun RPC (rpcgen + libtirpc)
# Ubuntu: sudo apt install rpcbind libtirpc-dev   (rpcgen comes with rpcsvc-proto)
CC      = gcc
CFLAGS  = -Wall -g -std=gnu99 -I/usr/include/tirpc
LDLIBS  = -ltirpc

# files generated by rpcgen from awale_rpc.x
RPC_GEN = awale_rpc.h awale_rpc_clnt.c awale_rpc_svc.c awale_rpc_xdr.c

SERVER_OBJ = awale_rpc_svc.o awale_rpc_xdr.o awale_server.o commands.o game.o user.o awale.o
CLIENT_OBJ = awale_rpc_clnt.o awale_rpc_xdr.o awale_client.o
LOCAL_OBJ  = local.o awale.o

all: server client local

$(RPC_GEN): awale_rpc.x
	rpcgen awale_rpc.x

server: $(SERVER_OBJ)
	$(CC) $(CFLAGS) -o $@ $(SERVER_OBJ) $(LDLIBS)

client: $(CLIENT_OBJ)
	$(CC) $(CFLAGS) -o $@ $(CLIENT_OBJ) $(LDLIBS)

local: $(LOCAL_OBJ)
	$(CC) $(CFLAGS) -o $@ $(LOCAL_OBJ)

%.o: %.c
	$(CC) $(CFLAGS) -c $<

# the code generated by rpcgen has harmless unused variables
awale_rpc_%.o: awale_rpc_%.c
	$(CC) $(CFLAGS) -Wno-unused-variable -c $<

# dependencies on headers
awale_rpc_svc.o awale_rpc_clnt.o awale_rpc_xdr.o: awale_rpc.h
awale_server.o: awale_server.c awale_rpc.h user.h game.h awale.h commands.h
awale_client.o: awale_client.c awale_rpc.h
awale.o:        awale.c awale.h
user.o:         user.c user.h
game.o:         game.c game.h awale.h user.h
commands.o:     commands.c commands.h game.h awale.h user.h
local.o:        local.c awale.h

clean:
	rm -f *.o server client local $(RPC_GEN)

# also removes saved games and profiles
distclean: clean
	rm -rf games profiles

.PHONY: all clean distclean
